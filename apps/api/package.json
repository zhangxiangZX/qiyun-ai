{
  "name": "qiyun-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('assets','dist/assets',{recursive:true})\"",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-api-tests.mjs",
    "test:integration": "node --test dist/integration/platform-integration.test.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.27",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.11",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
