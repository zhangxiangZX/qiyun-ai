# 仅证书签发前的 HTTP 临时生产模板；正式 HTTPS 见 docs/38 与 infra/.env.ecs.example
NODE_ENV=production
APP_NAME=qiyun-ai
APP_URL=http://console.qiyuntu.cn
PUBLIC_SITE_URL=http://www.qiyuntu.cn
PUBLIC_ENTRY_URL=http://go.qiyuntu.cn
PUBLIC_API_URL=http://api.qiyuntu.cn
WIDGET_CDN_URL=http://cdn.qiyuntu.cn
API_PORT=3001
API_BASE_URL=http://api:3001
NEXT_PUBLIC_API_BASE_URL=http://api.qiyuntu.cn
NEXT_PUBLIC_WIDGET_URL=http://cdn.qiyuntu.cn
NEXT_PUBLIC_PUBLIC_SITE_URL=http://www.qiyuntu.cn
NEXT_PUBLIC_ENTRY_URL=http://go.qiyuntu.cn
COOKIE_SECURE=false
CORS_ORIGIN=http://www.qiyuntu.cn,http://console.qiyuntu.cn,http://go.qiyuntu.cn

API_RUNTIME_DRIVER=postgres
API_SEED_PREVIEW=false
AUTH_SHOW_DEBUG_CODES=false
DATABASE_URL=postgresql://postgres:REPLACE_POSTGRES_PASSWORD@postgres:5432/qiyun_ai
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_VALUE
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_VALUE
MINIO_BUCKET=qiyun-ai
MINIO_REGION=us-east-1
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=qiyun_chunks
QDRANT_VECTOR_SIZE=1024
VECTOR_STORE_DRIVER=qdrant
DOCUMENT_QUEUE_DRIVER=redis
DOCUMENT_STORAGE_DRIVER=minio
DOCUMENT_STORAGE_DIR=/data/documents
DOCUMENT_DELETE_STRATEGY=archive

JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_VALUE
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=REPLACE_LLM_KEY
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=REPLACE_EMBEDDING_KEY
LLM_EMBEDDING_ENABLED=true
LLM_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
LLM_EMBEDDING_TIMEOUT_MS=10000
WORKER_CONCURRENCY=2

# Optional Dify Workflow knowledge cleaning. Keep disabled until the workflow is published.
DIFY_ENABLED=false
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=REPLACE_DIFY_WORKFLOW_KEY
DIFY_TIMEOUT_MS=30000
DIFY_CLEAN_OUTPUT_VARIABLE=cleaned_text
DIFY_CLEAN_FAIL_OPEN=true

EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_RESEND_KEY
EMAIL_FROM=noreply@qiyuntu.cn
EMAIL_REPLY_TO=sales@qiyuntu.cn
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=150
PLATFORM_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
PLATFORM_ADMIN_NAME=平台超级管理员
