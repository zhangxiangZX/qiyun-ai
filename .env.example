# 本地 / 开发默认。正式生产域名（HTTPS）见 docs/38-production-domains.md
# ECS 生产模板：infra/.env.ecs.example
NODE_ENV=development
APP_NAME=qiyun-ai
APP_URL=http://console.qiyuntu.cn
PUBLIC_SITE_URL=http://www.qiyuntu.cn
PUBLIC_ENTRY_URL=http://go.qiyuntu.cn
PUBLIC_API_URL=http://api.qiyuntu.cn
WIDGET_CDN_URL=http://cdn.qiyuntu.cn
API_PORT=3001
API_BASE_URL=http://api.qiyuntu.cn

# Widget 嵌入脚本地址（浏览器加载 /public/widget.js）
NEXT_PUBLIC_API_BASE_URL=http://api.qiyuntu.cn
NEXT_PUBLIC_WIDGET_URL=http://cdn.qiyuntu.cn
NEXT_PUBLIC_PUBLIC_SITE_URL=http://www.qiyuntu.cn
NEXT_PUBLIC_ENTRY_URL=http://go.qiyuntu.cn
NEXT_PUBLIC_WORKSPACE_ID=ws_dev

# Runtime mode:
# - memory: front-end preview / mock workspace state
# - postgres: persistent conversations, sites, leads, memberships
API_RUNTIME_DRIVER=memory
API_SEED_PREVIEW=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qiyun_ai
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qiyun-ai
MINIO_REGION=us-east-1

# Vector index reconcile retry (Qdrant)
QDRANT_URL=http://localhost:6333
VECTOR_RECONCILE_MAX_ATTEMPTS=3
VECTOR_RECONCILE_RETRY_DELAY_MS=500
QDRANT_COLLECTION_NAME=qiyun_chunks
QDRANT_VECTOR_SIZE=1024

VECTOR_STORE_DRIVER=memory
DOCUMENT_QUEUE_DRIVER=inline
DOCUMENT_QUEUE_MAX_ATTEMPTS=3
DOCUMENT_STORAGE_DRIVER=minio
DOCUMENT_STORAGE_DIR=E:/qiyun-ai/.data/documents
DOCUMENT_DELETE_STRATEGY=delete

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

EMAIL_PROVIDER=memory
# memory/console 模式下设为 true 可在页面显示验证码；接 Resend 后改为 false
AUTH_SHOW_DEBUG_CODES=false
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=sales@example.com
RESEND_API_KEY=
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=150

# 平台超级管理员（MVP A-01 / A-02）
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=change-me-platform
PLATFORM_ADMIN_NAME=平台管理员

# --- DeepSeek / OpenAI-compatible（聊天 + 知识库共用一把密钥）---
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_CHAT_MODEL=deepseek-chat
# 可选：单独 embedding 密钥；留空则自动复用上面的 LLM_API_KEY
LLM_EMBEDDING_API_KEY=

# Embedding 可单独指向支持 /embeddings 的 OpenAI-compatible 服务
# DeepSeek 本身无 embeddings；未配独立 embedding 时知识库用本地向量 + DeepSeek 生成回答
# 与 QDRANT_VECTOR_SIZE=1024 对应的模型维度需一致（bge-large-zh-v1.5 = 1024 维）
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_TIMEOUT_MS=10000
LLM_EMBEDDING_ENABLED=false
LLM_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Optional Dify Workflow cleaning between local parsing and embedding.
DIFY_ENABLED=false
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_TIMEOUT_MS=30000
DIFY_CLEAN_OUTPUT_VARIABLE=cleaned_text
DIFY_CLEAN_FAIL_OPEN=true

WORKER_CONCURRENCY=2
CORS_ORIGIN=http://www.qiyuntu.cn,http://console.qiyuntu.cn,http://go.qiyuntu.cn

# Optional rate-limit overrides
# RATE_LIMIT_AUTH_REGISTER_LIMIT=10
# RATE_LIMIT_AUTH_LOGIN_LIMIT=20
# RATE_LIMIT_AUTH_REFRESH_LIMIT=30
# RATE_LIMIT_WORKSPACE_INVITE_LIMIT=20
# RATE_LIMIT_WORKSPACE_INVITATION_ACCEPT_LIMIT=20
# RATE_LIMIT_WORKSPACE_INVITATION_RESEND_LIMIT=20
# RATE_LIMIT_SITES_TEST_MESSAGE_LIMIT=12
# RATE_LIMIT_PUBLIC_CHAT_IP_LIMIT=120
# RATE_LIMIT_PUBLIC_LEADS_IP_LIMIT=30
