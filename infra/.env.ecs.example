# 复制到仓库根目录为 .env，再按 ECS / 域名修改。
# cp infra/.env.ecs.example .env
#
# 正式域名（冻结）：docs/38-production-domains.md
# www / console / api / go / cdn · qiyuntu.cn · HTTPS

NODE_ENV=production
APP_NAME=qiyun-ai

# 浏览器公开地址（HTTPS）
APP_URL=https://console.qiyuntu.cn
PUBLIC_SITE_URL=https://www.qiyuntu.cn
PUBLIC_API_URL=https://api.qiyuntu.cn
PUBLIC_ENTRY_URL=https://go.qiyuntu.cn
NEXT_PUBLIC_WIDGET_URL=https://cdn.qiyuntu.cn
CORS_ORIGIN=https://www.qiyuntu.cn,https://console.qiyuntu.cn,https://go.qiyuntu.cn

API_PORT=3001
API_RUNTIME_DRIVER=postgres

# 数据库与中间件（容器内网服务名，勿改 host）
DATABASE_URL=postgresql://postgres:CHANGE_DB_PASSWORD@postgres:5432/qiyun_ai
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_MINIO_PASSWORD
MINIO_BUCKET=qiyun-ai
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=qiyun_chunks
QDRANT_VECTOR_SIZE=1536

VECTOR_STORE_DRIVER=qdrant
DOCUMENT_QUEUE_DRIVER=redis
DOCUMENT_STORAGE_DIR=/data/documents

# 用 openssl rand -hex 32 生成
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET

EMAIL_PROVIDER=memory
# 未接 Resend 前设为 true，验证码会显示在重置密码/验证码登录页面
AUTH_SHOW_DEBUG_CODES=true
EMAIL_FROM=noreply@qiyuntu.cn
EMAIL_REPLY_TO=sales@qiyuntu.cn
RESEND_API_KEY=
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=150

# LLM：换成你的 Key 与模型
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_EMBEDDING_TIMEOUT_MS=10000
LLM_EMBEDDING_ENABLED=true
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional Dify Workflow knowledge cleaning.
DIFY_ENABLED=false
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=REPLACE_DIFY_WORKFLOW_KEY
DIFY_TIMEOUT_MS=30000
DIFY_CLEAN_OUTPUT_VARIABLE=cleaned_text
DIFY_CLEAN_FAIL_OPEN=true

RATE_LIMIT_AUTH_REGISTER_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_LIMIT=10
RATE_LIMIT_AUTH_REFRESH_LIMIT=30
RATE_LIMIT_WORKSPACE_INVITE_LIMIT=20
RATE_LIMIT_WORKSPACE_INVITATION_ACCEPT_LIMIT=20
RATE_LIMIT_WORKSPACE_INVITATION_RESEND_LIMIT=10
RATE_LIMIT_SITES_TEST_MESSAGE_LIMIT=20
RATE_LIMIT_PUBLIC_CHAT_IP_LIMIT=60
RATE_LIMIT_PUBLIC_LEADS_IP_LIMIT=20

WORKER_CONCURRENCY=2

# 正式 HTTPS 必须为 true
COOKIE_SECURE=true

# 平台超级管理员（API 启动时自动创建）
PLATFORM_ADMIN_EMAIL=platform@qiyun.ai
PLATFORM_ADMIN_PASSWORD=CHANGE_PLATFORM_ADMIN_PASSWORD
PLATFORM_ADMIN_NAME=平台管理员

NEXT_PUBLIC_WORKSPACE_ID=ws_dev

# Compose 专用（与 DATABASE_URL 密码保持一致）
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
