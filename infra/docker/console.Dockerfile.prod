FROM node:20-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

WORKDIR /workspace

ARG NEXT_PUBLIC_API_BASE_URL=https://api.qiyuntu.cn
ARG NEXT_PUBLIC_WIDGET_URL=https://cdn.qiyuntu.cn
ARG NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.qiyuntu.cn
ARG NEXT_PUBLIC_ENTRY_URL=https://go.qiyuntu.cn
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_WIDGET_URL=$NEXT_PUBLIC_WIDGET_URL
ENV NEXT_PUBLIC_PUBLIC_SITE_URL=$NEXT_PUBLIC_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_ENTRY_URL=$NEXT_PUBLIC_ENTRY_URL

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY apps/console ./apps/console
COPY packages/ui ./packages/ui

RUN pnpm install --no-frozen-lockfile --ignore-scripts
RUN pnpm --filter qiyun-console build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["pnpm", "--filter", "qiyun-console", "start"]
